<?xml version = '1.0' encoding = 'utf-8'?>
<!--
  A logic check that compares against a field every route to it has skipped.

  `q2` is asked only when consent = 0, and such an interview ends at `q3`.
  `q5` is reached only when consent = 1 -- so `q2` is always blank when the
  check on `q5` runs. A blank operand passes, and the check can never fire.
-->
<survey>

	<question type = 'automatic' fieldname = 'starttime' fieldtype = 'datetime'>
	</question>

	<question type = 'automatic' fieldname = 'code' fieldtype = 'text'>
	</question>

	<question type = 'radio' fieldname = 'consent' fieldtype = 'integer'>
		<text>Consent</text>
		<responses>
			<response value = '1'>Yes</response>
			<response value = '0'>No</response>
		</responses>
		<postskip>
			<skip fieldname='consent' condition = '=' response='1' response_type='fixed' skiptofieldname ='q3'></skip>
		</postskip>
	</question>

	<question type = 'text' fieldname = 'q2' fieldtype = 'text'>
		<text>Reason for declining</text>
		<maxCharacters>20</maxCharacters>
	</question>

	<question type = 'text' fieldname = 'q3' fieldtype = 'text'>
		<text>Name</text>
		<maxCharacters>20</maxCharacters>
		<preskip>
			<skip fieldname='consent' condition = '&lt;&gt;' response='1' response_type='fixed' skiptofieldname ='end'></skip>
		</preskip>
	</question>

	<question type = 'text' fieldname = 'q5' fieldtype = 'text'>
		<text>Confirm</text>
		<maxCharacters>20</maxCharacters>
		<logic_check message='Must not repeat the reason'>q5 = q2</logic_check>
	</question>

	<question type = 'automatic' fieldname = 'uniqueid' fieldtype = 'text'>
	</question>

	<question type = 'automatic' fieldname = 'swver' fieldtype = 'text'>
	</question>

	<question type = 'automatic' fieldname = 'survey_id' fieldtype = 'text'>
	</question>

	<question type = 'automatic' fieldname = 'lastmod' fieldtype = 'datetime'>
	</question>

	<question type = 'automatic' fieldname = 'stoptime' fieldtype = 'datetime'>
	</question>

	<question type = 'information' fieldname = 'end_of_questions' fieldtype = 'n/a'>
		<text>Press the 'Finish' button to save the data.</text >
	</question>

</survey>
